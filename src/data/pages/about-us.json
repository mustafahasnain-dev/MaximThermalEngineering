"t":"text","html":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"32px\">Maxim Thermal Engineering is a leading industrial engineering company specializing in advanced thermal solutions, industrial equipment, and turnkey engineering services. With extensive technical expertise and a commitment to excellence, we deliver reliable, high-performance solutions that keep critical industries operating efficiently.</span>","st":{"fs":"18px","lh":"32px","fw":"400","c":"rgb(97, 97, 97)","ta":"start","tt":"none","ls":"normal","mb":"0px"}}]}]},{"t":"row","cls":["background-cover-767","vc_column-gap-40"],"bg":"rgb(255, 255, 255)","bgi":"map_transparent_dark.png","bgSize":"contain","bgPos":"50% 50%","contained":true,"pad":["0px","56px"],"mar":["0px","0px"],"w":1465,"h":424,"c":"rgb(97, 97, 97)","cols":[{"w":6,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 20px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[620,368],"items":[{"t":"h","tag":"h2","html":"About Maxim","st":{"fs":"40px","lh":"48px","fw":"800","c":"rgb(33, 33, 33)","ta":"left","tt":"uppercase","ls":"0.5px","mb":"24px"},"wrap":{"bg":null,"pad":"0px 0px 0px 16px","c":"rgb(33, 33, 33)"},"bar":{"p":"::before","bg":"rgb(198, 40, 40)","w":"4px","h":"38.3906px","l":"0px","t":"24px","pos":"absolute"}},{"t":"gap","h":32},{"t":"text","html":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"32px\">Behind every successful organization is a leader driven by vision, integrity, technical expertise, and a dedicated team committed to excellence. At Maxim Thermal Engineering, these values shape everything we do, enabling us to deliver reliable cooling solutions for mission-critical equipment such as radiators and heat exchangers. Trusted by Pakistan’s leading industries, we work as an extension of our clients’ teams, ensuring dependable performance, long-term partnerships, and uncompromising quality.</span>","st":{"fs":"18px","lh":"32px","fw":"400","c":"rgb(97, 97, 97)","ta":"start","tt":"none","ls":"normal","mb":"0px"}}]},{"w":6,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 20px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[620,1],"items":[{"t":"counter","v":"","post":"+","title":"Corporate Industrial Clients","size":"small"},{"t":"counter","v":"","post":"+","title":"On Going Projects","size":"medium"},{"t":"counter","v":"","post":"+","title":"Projects Completed","size":"large"}]}]},{"t":"row","cls":["background-cover-767","vc_column-gap-40"],"bg":"rgb(255, 255, 255)","bgi":"map_transparent_dark.png","bgSize":"contain","bgPos":"50% 50%","contained":true,"pad":["0px","56px"],"mar":["0px","0px"],"w":1465,"h":706,"c":"rgb(97, 97, 97)","cols":[{"w":6,"off":0,"ccls":["text-align-center"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 20px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[620,573],"items":[{"t":"h","tag":"h3","html":"CEO","st":{"fs":"50px","lh":"80px","fw":"800","c":"rgb(33, 33, 33)","ta":"left","tt":"none","ls":"normal","mb":"0px"},"wrap":{"bg":null,"pad":"0px","c":"rgb(33, 33, 33)"},"bar":null},{"t":"gap","h":5},{"t":"text","html":"<p style=\"text-align: left;\"><span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"32px\"></span></p> <p class=\"PDq2pG_selectionAnchorContainer\" style=\"text-align: left;\">With over <strong>12 years of industry experience</strong>, our CEO has been the driving force behind the company’s growth, innovation, and commitment to engineering excellence. His vision, leadership, and dedication have transformed the organization into a trusted provider of high-quality thermal engineering solutions.</p> <p style=\"text-align: left;\">Throughout his career, he has successfully led projects across diverse industrial sectors, specializing in <strong>radiators, heat exchangers, cooling systems, and custom thermal engineering solutions</strong>. His focus on quality, customer satisfaction, and continuous improvement has earned the trust of clients both locally and internationally.</p> <p style=\"text-align: left;\">Under his leadership, the company continues to invest in advanced technologies, skilled professionals, and modern manufacturing practices to deliver reliable and efficient solutions that meet the evolving needs of industries worldwide.</p>","st":{"fs":"16px","lh":"32px","fw":"400","c":"rgb(97, 97, 97)","ta":"left","tt":"none","ls":"normal","mb":"24px"}}]},{"w":6,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 20px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[620,650],"items":[{"t":"img","src":"Shoaib-Iqbal.jpeg","alt":"Maxim Thermal Engineering","w":1122,"h":1402,"dw":400,"align":"center"}]}]},{"t":"row","cls":[],"bg":null,"bgi":null,"contained":true,"pad":["96px","0px"],"mar":["0px","0px"],"w":1425,"h":266,"c":"rgb(97, 97, 97)","cols":[{"w":3,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[300,1],"items":[]},{"w":6,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[600,170],"items":[{"t":"img","src":"Maxim-logo.png","alt":"Maxim Thermal Engineering","w":1573,"h":363,"dw":600,"align":"center"},{"t":"gap","h":32}]},{"w":3,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[300,1],"items":[]}]},{"t":"row","cls":["vc_column-gap-24"],"bg":null,"bgi":null,"contained":true,"pad":["0px","96px"],"mar":["0px","0px"],"w":1449,"h":968,"c":"rgb(97, 97, 97)","cols":[{"w":12,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 12px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[1224,872],"items":[{"t":"steps","cols":2,"items":[{"n":"1","title":"Our Foundation","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">Built on integrity, innovation, and engineering excellence, our foundation is rooted in delivering dependable solutions that exceed industry standards. We believe in long-term partnerships, technical precision, and creating lasting value through quality workmanship and customer-focused service.</span>"},{"n":"2","title":"Our Mission","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">To provide innovative, reliable, and cost-effective engineering solutions that maximize operational efficiency, improve equipment performance, and support the long-term success of our clients across diverse industries.</span>"},{"n":"3","title":"Our Vision","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">To become the most trusted engineering and thermal solutions partner in the region by continuously advancing technology, maintaining the highest quality standards, and delivering sustainable solutions that power industrial growth.</span>"},{"n":"4","title":"Our Expertise","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">Our expertise spans industrial radiators, heat exchangers, industrial cooling systems, HVAC, fabrication, boiler engineering, generator and compressor services, solar energy systems, mechanical, electrical &amp; civil contracting, and industrial supplies. Every solution is engineered to deliver superior performance, durability, and reliability.</span>"},{"n":"5","title":"Our Commitment","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">We are committed to building lasting relationships through technical excellence, transparent communication, timely project execution, and dependable after-sales support. Every project is delivered with professionalism, safety, and an unwavering focus on customer satisfaction.</span>"},{"n":"6","title":"Quality Assurance","text":"<span class=\"et-font-size\" data-fontsize=\"18px\" data-lineheight=\"28px\">Quality is at the core of everything we do. From engineering design and material selection to manufacturing, installation, and testing, every solution undergoes rigorous quality control to ensure exceptional performance, reliability, and compliance with industry standards. Our commitment to continuous improvement enables us to consistently deliver products and services our clients can trust.</span>"}],"tst":{"fs":"32px","lh":"32px","fw":"900","c":"rgb(33, 33, 33)","ta":"start","tt":"none","ls":"0.25px","mb":"16px"},"pst":{"fs":"16px","lh":"32px","fw":"400","c":"rgb(97, 97, 97)","ta":"start","tt":"none","ls":"normal","mb":"0px"},"dot":{"bg":"rgb(198, 40, 40)","c":"rgb(97, 97, 97)","w":"16px"}}]}]},{"t":"row","cls":["vc_column-gap-24"],"bg":null,"bgi":null,"contained":true,"pad":["40px","0px"],"mar":["0px","0px"],"w":1449,"h":112,"c":"rgb(97, 97, 97)","cols":[{"w":12,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 12px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[1224,72],"items":[{"t":"h","tag":"h2","html":"Contact Us","st":{"fs":"40px","lh":"48px","fw":"800","c":"rgb(33, 33, 33)","ta":"left","tt":"uppercase","ls":"0.5px","mb":"24px"},"wrap":{"bg":null,"pad":"0px 0px 0px 16px","c":"rgb(33, 33, 33)"},"bar":{"p":"::before","bg":"rgb(198, 40, 40)","w":"4px","h":"38.3906px","l":"0px","t":"24px","pos":"absolute"}}]}]},{"t":"row","cls":["vc_column-gap-24"],"bg":null,"bgi":null,"contained":true,"pad":["0px","0px"],"mar":["0px","0px"],"w":1449,"h":582,"c":"rgb(97, 97, 97)","cols":[{"w":12,"off":0,"ccls":["text-align-none"],"bg":null,"bgi":null,"pad":"0px","cpad":"0px 12px","border":"0px none rgb(97, 97, 97)","c":"rgb(97, 97, 97)","rect":[1224,582],"items":[{"t":"map","src":"https://maps.google.com/maps?q=Plot%20%23257%2C%20Sector%205%2C%20Korangi%20Industrial%20Area%2C%20Karachi&t=&z=15&ie=UTF8&iwloc=&output=embed","h":500},{"t":"gap","h":7