---
// Same fields as the old Contact Form 7 form. Submitted through Netlify Forms.
---
<form class="cf" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company">
  <input type="hidden" name="form-name" value="contact" />
  <p class="hp" aria-hidden="true"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></p>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <label class="sr-only" for={`cf-name-${Astro.url.pathname}`}>Your Name</label>
  <input id={`cf-name-${Astro.url.pathname}`} type="text" name="your-name" placeholder="Your Name" required autocomplete="name" />
  <label class="sr-only" for={`cf-email-${Astro.url.pathname}`}>Your Email</label>
  <input id={`cf-email-${Astro.url.pathname}`} type="email" name="your-email" placeholder="Your Email" required autocomplete="email" />
  <label class="sr-only" for={`cf-subject-${Astro.url.pathname}`}>Your subject</label>
  <input id={`cf-subject-${Astro.url.pathname}`} type="text" name="your-subject" placeholder="Your subject" />
  <label class="sr-only" for={`cf-msg-${Astro.url.pathname}`}>Your message</label>
  <textarea id={`cf-msg-${Astro.url.pathname}`} name="your-message" rows="6" placeholder="Your message"></textarea>
  <button type="submit" class="btn">Send message</button>
</form>
<style>
  .cf { display: grid; gap: 24px; }
  .cf input, .cf textarea { width: 100%; height: 56px; padding: 0 24px; border: 1px solid var(--line); background: #fff; font-size: 16px; color: var(--text); outline: none; transition: border-color .2s; }
  .cf textarea { height: 200px; padding: 16px 24px; resize: vertical; }
  .cf input:focus, .cf textarea:focus { border-color: var(--ink); }
  .cf .btn { justify-self: start; height: 56px; padding: 0 32px; }
  .hp { position: absolute; left: -9999px; }
</style>
