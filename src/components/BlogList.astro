---
import PostCard from './PostCard.astro';
import { posts } from '../data/posts';
---
<section class="container sec">
  <div class="grid">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</section>
<style>
  .sec { padding: 80px 0 96px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .grid { grid-template-columns: 1fr; } }
</style>
