---
// Builds every head tag from page data: title, description, canonical, Open Graph, Twitter and JSON-LD.
import { site, locations } from '../data/site';

export interface Crumb { name: string; href: string }
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  localBusiness?: boolean;
}

const { title, description, ogImage = '/video/hero-poster.jpg', ogType = 'website', noindex = false, breadcrumbs = [], schema = [], localBusiness = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const orgId = `${site.url}/#organization`;
const abs = (href: string) => new URL(href, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': orgId,
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/logo/Maxim-logo.png`,
  description: site.description,
  telephone: site.phoneE164,
  areaServed: { '@type': 'Country', name: 'Pakistan' },
  contactPoint: { '@type': 'ContactPoint', telephone: site.phoneE164, contactType: 'sales', areaServed: 'PK', availableLanguage: ['en', 'ur'] },
};

const businesses = localBusiness
  ? locations.map((l) => ({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${site.url}/#${l.id}`,
      name: `${site.name}, ${l.kind}, ${l.city}`,
      parentOrganization: { '@id': orgId },
      url: `${site.url}/`,
      telephone: site.phoneE164,
      image: `${site.url}/logo/Maxim-logo.png`,
      address: { '@type': 'PostalAddress', streetAddress: l.street, addressLocality: l.city, addressCountry: 'PK' },
      hasMap: l.map,
      areaServed: { '@type': 'Country', name: 'Pakistan' },
    }))
  : [];

const breadcrumbList = breadcrumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
    }]
  : [];

const jsonLd = [organization, ...businesses, ...breadcrumbList, ...schema];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="en_PK" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
