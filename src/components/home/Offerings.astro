---
import { Image } from 'astro:assets';
import { features, moreServices } from '../../data/home';
import { wa } from '../../data/site';
---
<section id="offerings" class="off" aria-labelledby="off-h">
  <div class="wrap in">
    <h2 class="banner" id="off-h">Our Offerings</h2>
    <p class="lead intro">Choose your equipment and request a quote. Our engineers reply with a clear technical answer.</p>

    {features.map((f, i) => (
      <article class:list={['feat', { rev: i % 2 === 1 }]} id={f.id} aria-labelledby={`${f.id}-h`}>
        <div class="m">
          <Image src={f.image} alt={f.alt} widths={[480, 720, 960]} sizes="(max-width: 1000px) 100vw, 600px" class="img-cover" />
        </div>
        <div class="t">
          <h3 id={`${f.id}-h`}>{f.title}</h3>
          <p class="body">{f.body}</p>
          <ul class="bul">{f.bullets.map((b) => <li>{b}</li>)}</ul>
          <div class="btn-row">
            <a class="btn btn-red" href="#quote" data-need={f.need} data-track="cta_quote" data-track-service={f.id}>{f.cta} &rsaquo;</a>
            <a class="btn btn-ink" href={wa(f.waText)} data-track="whatsapp_click" data-track-location="offerings" data-track-service={f.id}>Ask on WhatsApp</a>
          </div>
          <a class="clink more" href={f.page}>All about {f.title.toLowerCase()} &rsaquo;</a>
        </div>
      </article>
    ))}

    <h3 class="more-h">More from Maxim</h3>
    <div class="g3">
      {moreServices.map((s) => (
        <article class="card" id={s.id}>
          <Image src={s.image} alt={`[placeholder] ${s.photo}`} widths={[400, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 400px" class="card-img" />
          <div class="card-b">
            <h4>{s.title}</h4>
            <p>{s.blurb}</p>
            <a class="clink" href="#quote" data-need={s.need} data-prefill={`Service: ${s.title}`} data-track="cta_quote" data-track-service={s.title}>Get a quote<span class="sr-only"> for {s.title}</span> &rsaquo;</a>
            {s.page && <a class="clink" href={s.page}>Details<span class="sr-only"> about {s.title}</span> &rsaquo;</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .off { border-top: 1px solid var(--rule); }
  .in { padding-top: var(--section-y); padding-bottom: 40px; }
  .intro { margin-bottom: 56px; }
  .feat { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; margin-bottom: 72px; }
  .feat.rev { flex-direction: row-reverse; }
  .m { flex: 1 1 480px; min-width: 0; height: 360px; background: var(--grey-2); }
  .t { flex: 1 1 380px; min-width: 0; }
  h3 { font-weight: 900; font-size: clamp(26px, 3vw, 38px); line-height: 1.1; text-transform: uppercase; margin-bottom: 14px; }
  .more { margin-top: 12px; }
  .body { font-size: 17px; line-height: 1.65; color: var(--muted); }
  .more-h { font-size: 22px; margin-bottom: 20px; padding-top: 16px; border-top: 2px solid var(--ink); }
  .card { display: flex; flex-direction: column; background: var(--grey); }
  .card-img { width: 100%; height: 150px; object-fit: cover; }
  .card-b { display: flex; flex-direction: column; gap: 8px; padding: 22px; flex-grow: 1; }
  h4 { font-weight: 900; font-size: 19px; line-height: 1.25; }
  .card-b p { font-size: 15px; line-height: 1.6; color: var(--muted); flex-grow: 1; }
  @media (max-width: 700px) {
    .intro { margin-bottom: 40px; }
    .feat, .feat.rev { flex-direction: column; align-items: stretch; gap: 24px; margin-bottom: 56px; }
    .m { flex: none; height: 240px; }
    .t { flex: none; }
    .btn-row .btn { flex: 1 1 100%; }
  }
</style>
