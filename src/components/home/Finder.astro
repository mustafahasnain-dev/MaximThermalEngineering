---
import { finder } from '../../data/finder';
import { wa } from '../../data/site';

const waFor = (key: string) => wa(`Hello Maxim Thermal, I need cooling for: ${key}. `);
const first = finder[0]!;
const data = finder.map((f) => ({ ...f, wa: waFor(f.key) }));
---
<section id="finder" class="finder" aria-labelledby="finder-h">
  <div class="wrap section">
    <h2 class="banner" id="finder-h">What are you cooling?</h2>
    <p class="lead">Pick your equipment and see what we build, repair and install for it.</p>
    <div class="chips" role="group" aria-label="Equipment type" data-finder data-options={JSON.stringify(data)}>
      {finder.map((f, i) => (
        <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-finder-chip={i} data-track="finder_select" data-track-equipment={f.key}>{f.key}</button>
      ))}
    </div>
    <div class="result" aria-live="polite" aria-atomic="true">
      <div class="r-copy">
        <h3 data-finder-title>{first.title}</h3>
        <ul class="bul bul-1" data-finder-items>
          {first.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="r-cta">
        <a class="btn btn-red" href="#quote" data-finder-quote data-need={first.need} data-prefill={`Equipment: ${first.key}`} data-track="finder_cta" data-track-channel="quote" data-track-equipment={first.key}>Get a quote for this &rsaquo;</a>
        <a class="btn btn-ink" href={waFor(first.key)} data-finder-wa data-track="finder_cta" data-track-channel="whatsapp" data-track-equipment={first.key}>Ask on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<script>
  interface Opt { key: string; need: string; title: string; items: string[]; wa: string }
  const group = document.querySelector<HTMLElement>('[data-finder]');
  if (group) {
    const opts: Opt[] = JSON.parse(group.dataset.options || '[]');
    const chips = [...group.querySelectorAll<HTMLButtonElement>('[data-finder-chip]')];
    const title = document.querySelector('[data-finder-title]');
    const list = document.querySelector('[data-finder-items]');
    const quote = document.querySelector<HTMLAnchorElement>('[data-finder-quote]');
    const waLink = document.querySelector<HTMLAnchorElement>('[data-finder-wa]');

    const pick = (i: number) => {
      const o = opts[i];
      if (!o) return;
      chips.forEach((c, j) => c.setAttribute('aria-pressed', String(i === j)));
      if (title) title.textContent = o.title;
      if (list) list.replaceChildren(...o.items.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
      if (waLink) { waLink.href = o.wa; waLink.dataset.trackEquipment = o.key; }
      if (quote) {
        quote.dataset.trackEquipment = o.key;
        quote.dataset.need = o.need;
        quote.dataset.prefill = `Equipment: ${o.key}`;
      }
    };
    chips.forEach((c, i) => c.addEventListener('click', () => pick(i)));
  }
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .chip { min-height: 52px; padding: 12px 22px; border: 2px solid var(--ink); border-radius: 0; background: var(--white); color: var(--ink); font-family: var(--font); font-weight: 800; font-size: 16px; cursor: pointer; }
  .chip:hover { background: var(--grey-2); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--white); }
  .result { margin-top: 20px; background: var(--grey); border-top: 6px solid var(--red); padding: 32px; display: flex; flex-wrap: wrap; gap: 28px 48px; align-items: flex-start; }
  .r-copy { flex: 1.5 1 380px; min-width: 0; }
  h3 { font-weight: 900; font-size: 26px; line-height: 1.15; margin-bottom: 14px; }
  .r-cta { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  @media (max-width: 700px) {
    .chips { gap: 8px; }
    .chip { padding: 10px 16px; font-size: 15px; }
    .result { padding: 24px 16px; }
    .r-cta { align-items: stretch; flex-basis: 100%; }
  }
</style>
