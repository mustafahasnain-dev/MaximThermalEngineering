---
import { site, wa, needOptions, cityOptions } from '../../data/site';
import LeadHidden from '../ui/LeadHidden.astro';
---
<div class="qf">
  <form
    action={site.formAction}
    method="post"
    novalidate
    data-lead-form="hero"
    data-track="generate_lead"
    data-track-form="hero"
    aria-labelledby="qf-h"
  >
    <LeadHidden form="hero" />
    <h2 id="qf-h">Get a quote</h2>
    <p class="intro">Tell us what needs cooling. A short note is enough to start.</p>
    <div class="fields">
      <fieldset>
        <legend class="lbl">How urgent is it?</legend>
        <div class="two">
          <label class="radio"><input type="radio" name="urgency" value="Planned" checked data-urgency />Planned</label>
          <label class="radio"><input type="radio" name="urgency" value="Breakdown" data-urgency />Breakdown</label>
        </div>
      </fieldset>
      <p class="alert" data-breakdown-alert hidden>
        For a breakdown, call <a href={site.phoneHref} data-track="phone_click" data-track-location="hero_form">{site.phoneDisplay}</a> now, then send this form so we have the details.
      </p>
      <div>
        <label class="lbl" for="h-name">Your name</label>
        <input class="fld" id="h-name" name="name" type="text" autocomplete="name" required aria-describedby="h-name-err" />
        <span class="err" id="h-name-err"></span>
      </div>
      <div>
        <label class="lbl" for="h-ph">Phone / WhatsApp</label>
        <input class="fld" id="h-ph" name="phone" type="tel" inputmode="tel" autocomplete="tel" required data-phone aria-describedby="h-ph-err" />
        <span class="err" id="h-ph-err"></span>
      </div>
      <div class="two">
        <div>
          <label class="lbl" for="h-need">I need</label>
          <select class="fld" id="h-need" name="need" data-need-select>
            {needOptions.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div>
          <label class="lbl" for="h-city">City</label>
          <select class="fld" id="h-city" name="city">
            {cityOptions.map((o) => <option>{o}</option>)}
          </select>
        </div>
      </div>
      <div>
        <label class="lbl" for="h-msg">Make, model or capacity <span class="opt">(optional)</span></label>
        <textarea class="fld" id="h-msg" name="details" rows="2"></textarea>
      </div>
      <button class="btn btn-red btn-block" type="submit">Send my request &rsaquo;</button>
    </div>
  </form>
  <div class="done" role="status" tabindex="-1" data-lead-success hidden>
    <h2>Request received</h2>
    <p>Thank you. Our team will review your requirement and contact you on the number you gave. For anything urgent, message us on WhatsApp now.</p>
    <a class="btn btn-wa" href={wa('Hello Maxim Thermal, I just sent a quote request.')} data-track="whatsapp_click" data-track-location="hero_form_success">Open WhatsApp</a>
  </div>
</div>

<style>
  .qf { background: var(--white); color: var(--ink); padding: 30px; border-top: 8px solid var(--red); }
  h2 { font-weight: 900; font-size: 28px; line-height: 1.1; margin-bottom: 8px; }
  .intro { font-size: 16px; line-height: 1.55; color: var(--muted); margin-bottom: 18px; }
  .fields { display: flex; flex-direction: column; gap: 14px; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; }
  .alert { background: var(--red-soft); border: 2px solid var(--red); padding: 12px 14px; font-size: 15px; line-height: 1.5; font-weight: 700; }
  .alert a { color: var(--red-hover); text-decoration: underline; font-weight: 900; }
  .done { padding: 24px 0; }
  .done h2 { margin-bottom: 12px; }
  .done p { font-size: 16px; line-height: 1.7; color: var(--muted); margin-bottom: 24px; }
  .qf a:focus-visible, .qf button:focus-visible, .qf input:focus-visible, .qf select:focus-visible, .qf textarea:focus-visible { outline-color: var(--blue); }
  @media (max-width: 700px) {
    .qf { padding: 28px 16px; }
  }
  @media (max-width: 380px) {
    .two { grid-template-columns: minmax(0, 1fr); }
  }
</style>
