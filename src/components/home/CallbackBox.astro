---
import { site } from '../../data/site';
import LeadHidden from '../ui/LeadHidden.astro';
---
<div class="cbx">
  <form action={site.formAction} method="post" novalidate data-lead-form="callback" data-track="generate_lead" data-track-form="callback">
    <LeadHidden form="callback" />
    <label for="cb-ph" class="t">Prefer a call? Leave your number.</label>
    <div class="row">
      <input id="cb-ph" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="03XX XXXXXXX" required data-phone aria-describedby="cb-ph-err" />
      <button class="btn btn-red" type="submit">Call me back</button>
    </div>
    <span class="err err-on-dark" id="cb-ph-err"></span>
  </form>
  <p class="ok" role="status" tabindex="-1" data-lead-success hidden>Thank you. Our team will call you on that number.</p>
</div>

<style>
  .cbx { background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.4); padding: 18px 20px; }
  .t { display: block; font-weight: 800; font-size: 16px; margin-bottom: 10px; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; }
  input { flex: 1 1 200px; min-width: 0; min-height: 48px; padding: 10px 14px; border: 2px solid var(--white); border-radius: 2px; background: var(--white); color: var(--ink); font-family: var(--font); font-size: 16px; }
  input[aria-invalid='true'] { border-color: var(--red-on-dark); }
  .ok { font-weight: 800; font-size: 16px; line-height: 1.5; }
  @media (max-width: 700px) { .row .btn { flex: 1 1 100%; } }
</style>
