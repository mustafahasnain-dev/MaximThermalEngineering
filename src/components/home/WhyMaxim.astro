---
import { reasons } from '../../data/home';
---
<section class="why dark" aria-labelledby="why-h">
  <div class="wrap in">
    <h2 id="why-h">Why Pakistan's industry chooses Maxim</h2>
    <div class="g4">
      {reasons.map((r) => (
        <div class="r">
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why { background: var(--red); color: var(--white); }
  .in { padding-top: 80px; padding-bottom: 80px; }
  h2 { font-weight: 900; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.1; text-transform: uppercase; margin-bottom: 44px; }
  .r { border-top: 3px solid var(--white); padding-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  h3 { font-weight: 900; font-size: 20px; line-height: 1.2; }
  p { font-size: 16px; line-height: 1.65; }
  @media (max-width: 700px) { .in { padding-top: 64px; padding-bottom: 64px; } }
</style>
