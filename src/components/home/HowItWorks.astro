---
import { steps } from '../../data/home';
---
<section class="how" aria-labelledby="how-h">
  <div class="wrap in">
    <h2 class="banner" id="how-h">How it works</h2>
    <ol class="g4">
      {steps.map((s) => (
        <li>
          <span class="n" aria-hidden="true">{s.n}</span>
          <h3><span class="sr-only">Step {s.n}: </span>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="cta"><a class="btn btn-red" href="#quote" data-track="cta_quote" data-track-service="how_it_works">Start with a quote &rsaquo;</a></div>
  </div>
</section>

<style>
  .in { padding-top: 80px; padding-bottom: 80px; }
  ol { margin: 44px 0 0; padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; gap: 12px; }
  .n { width: 46px; height: 46px; background: var(--red); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 18px; }
  h3 { font-weight: 900; font-size: 20px; line-height: 1.2; }
  p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  .cta { margin-top: 40px; }
  @media (max-width: 700px) { .in { padding-top: 64px; padding-bottom: 64px; } }
</style>
