---
const rings = [
  { value: '1600+', label: 'Projects completed', cls: 'r1', arc: 'M50 1.5 A48.5 48.5 0 0 1 90 22', sw: 1.1 },
  { value: '400+', label: 'Corporate industrial clients', cls: 'r2', arc: 'M10 28 A48.5 48.5 0 0 1 40 3', sw: 1.4 },
  { value: '20+', label: 'Ongoing projects', cls: 'r3', arc: 'M60 2 A48.5 48.5 0 0 1 94 30', sw: 1.3 },
];
---
<section id="about" class="about" aria-labelledby="about-h">
  <div class="wrap in">
    <div class="copy">
      <div class="title"><h2 id="about-h">Maxim Thermal<br />Engineering</h2></div>
      <p>Behind every successful organization is a leader driven by vision, integrity, technical expertise, and a dedicated team committed to excellence. At Maxim Thermal Engineering, these values shape everything we do, enabling us to deliver reliable cooling solutions for mission-critical equipment such as radiators and heat exchangers. Trusted by Pakistan's leading industries, we work as an extension of our clients' teams, ensuring dependable performance, long-term partnerships, and uncompromising quality.</p>
      <a class="btn btn-red" href="#quote" data-track="cta_quote" data-track-service="about">Talk to our engineers &rsaquo;</a>
    </div>
    <ul class="rings" aria-label="Company figures">
      {rings.map((r) => (
        <li class:list={['ring', r.cls]}>
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="48.5" fill="none" stroke="#C5C9CF" stroke-width="0.6" stroke-dasharray="1.5 1.5" />
            <path d={r.arc} fill="none" stroke="var(--red)" stroke-width={r.sw} />
          </svg>
          <b>{r.value}</b><span>{r.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about { border-top: 1px solid var(--rule); }
  .in { display: flex; flex-wrap: wrap; align-items: center; gap: 40px; padding-top: var(--section-y); padding-bottom: var(--section-y); }
  .copy { flex: 1 1 460px; min-width: 0; }
  .title { border-left: 5px solid var(--red); padding-left: 16px; margin-bottom: 28px; }
  h2 { font-weight: 900; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.15; text-transform: uppercase; }
  .copy p { font-size: 18px; line-height: 1.8; color: var(--muted); margin-bottom: 28px; }

  .rings { position: relative; flex: 1 1 520px; min-width: 0; min-height: 560px; background-image: radial-gradient(#E3E5E8 2px, transparent 2.5px); background-size: 15px 15px; -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 60%, transparent 100%); mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 60%, transparent 100%); }
  .ring { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border-radius: 50%; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring b { position: relative; font-weight: 800; line-height: 1; color: var(--red); }
  .ring span { position: relative; font-weight: 700; color: var(--ink); line-height: 1.35; }
  .r1 { left: 6%; top: 24%; width: 300px; height: 300px; }
  .r1 b { font-size: 62px; } .r1 span { font-size: 20px; }
  .r2 { right: 2%; top: 2%; width: 200px; height: 200px; }
  .r2 b { font-size: 44px; } .r2 span { font-size: 16px; padding: 0 20px; }
  .r3 { right: 6%; bottom: 0; width: 230px; height: 230px; }
  .r3 b { font-size: 50px; } .r3 span { font-size: 17px; }

  @media (max-width: 1000px) {
    .rings { flex-basis: 100%; max-width: 620px; margin: 0 auto; }
  }
  @media (max-width: 700px) {
    .rings { min-height: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; -webkit-mask-image: none; mask-image: none; }
    .ring { position: relative; inset: auto; width: 220px; height: 220px; }
    .ring b { font-size: 48px; }
    .ring span { font-size: 17px; padding: 0 24px; }
  }
</style>
