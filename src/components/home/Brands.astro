---
import { brands } from '../../data/site';
---
<section class="brands" aria-labelledby="brands-h">
  <div class="wrap in">
    <h2 id="brands-h">We cool equipment from</h2>
    <ul>
      {brands.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<style>
  .brands { background: var(--grey); border-bottom: 1px solid var(--rule); }
  .in { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 24px; padding-bottom: 24px; }
  h2 { font-weight: 900; font-size: 15px; text-transform: uppercase; letter-spacing: 0.5px; }
  ul { display: contents; }
  li { font-weight: 800; font-size: 17px; color: var(--muted); }
  @media (max-width: 700px) { .in { gap: 8px 20px; } h2 { flex-basis: 100%; } }
</style>
