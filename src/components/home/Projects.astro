---
import { Image } from 'astro:assets';
import { projects } from '../../data/home';
---
<section id="projects" class="proj" aria-labelledby="proj-h">
  <div class="wrap section">
    <h2 class="banner" id="proj-h">Featured Projects</h2>
    <div class="g2 list">
      {projects.map((p) => (
        <article class="card">
          <Image src={p.image} alt={p.alt} widths={[600, 900, 1200]} sizes="(max-width: 700px) 100vw, 600px" class="pimg" />
          <div class="b">
            <span class="eyebrow tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.scope}</p>
            <p><strong>Result:</strong> {p.result}</p>
            <div class="links">
              <a class="clink" href="#contact">Read the case study<span class="sr-only">: {p.title}</span> &rsaquo;</a>
              <a class="clink" href="#quote" data-prefill={`Similar to: ${p.title}`} data-track="cta_quote" data-track-service="project">Quote a similar job &rsaquo;</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proj { background: var(--grey); }
  .list { margin-top: 44px; }
  .card { display: flex; flex-direction: column; background: var(--white); }
  .pimg { width: 100%; height: 300px; object-fit: cover; }
  .b { display: flex; flex-direction: column; gap: 12px; padding: 28px; }
  .tag { font-size: 13px; letter-spacing: 1.5px; }
  h3 { font-weight: 900; font-size: 24px; line-height: 1.2; }
  p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  strong { color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  @media (max-width: 700px) { .pimg { height: 220px; } .b { padding: 24px 16px; } }
</style>
