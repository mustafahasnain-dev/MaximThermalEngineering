---
import { locations, cityOptions } from '../../data/site';
---
<section id="locations" class="loc" aria-labelledby="loc-h">
  <div class="wrap section">
    <h2 class="banner" id="loc-h">Find your nearest Maxim team</h2>
    <p class="lead intro">Workshops in Karachi and Lahore and a factory in Faisalabad, with installation anywhere in Pakistan.</p>
    <div class="g4">
      {locations.map((l) => (
        <article class="card" aria-labelledby={`${l.id}-h`}>
          <span class="eyebrow">{l.kind}</span>
          <h3 id={`${l.id}-h`}>{l.city}</h3>
          <address>{l.addr}</address>
          <a class="clink" href={l.map} target="_blank" rel="noopener" data-track="directions_click" data-track-city={l.city} data-track-site={l.id}>Get directions<span class="sr-only"> to {l.kind}, {l.city} (opens in a new tab)</span> &rsaquo;</a>
          <a class="clink" href="#quote" data-city={cityOptions.includes(l.city) ? l.city : 'Other'} data-track="cta_quote" data-track-service={`location_${l.id}`}>Quote from this site<span class="sr-only">: {l.kind}, {l.city}</span> &rsaquo;</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .loc { background: var(--grey); }
  .intro { margin-bottom: 40px; }
  .card { background: var(--white); border-top: 6px solid var(--red); padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  h3 { font-weight: 900; font-size: 22px; line-height: 1.15; }
  address { font-style: normal; font-size: 15px; line-height: 1.6; color: var(--muted); flex-grow: 1; }
</style>
