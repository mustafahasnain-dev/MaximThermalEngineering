---
import { site, waDefault } from '../../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr dark">
  <div class="wrap ftr-in">
    <div class="cols">
      <div class="about">
        <p class="name">{site.name}</p>
        <p class="txt">Maxim Thermal Engineering specializes in industrial radiators, heat exchangers, HVAC coils, and cooling systems.</p>
      </div>
      <nav aria-label="Offerings" class="col">
        <p class="hd">Offerings</p>
        <a href="/services/industrial-radiators/">Industrial radiators</a>
        <a href="/services/heavy-machinery-radiators-coolers/">Heavy machinery radiators</a>
        <a href="/services/heat-exchangers/">Heat exchangers</a>
        <a href="/services/hvac-solutions/">HVAC solutions</a>
        <a href="/services/oil-air-fuel-coolers/">Oil, air &amp; fuel coolers</a>
        <a href="/services/radiator-repair-refurbishment/">Radiator repair</a>
        <a href="/services/">All services</a>
      </nav>
      <nav aria-label="Company" class="col">
        <p class="hd">Company</p>
        <a href="/#about">About us</a>
        <a href="/#locations">Locations</a>
        <a href="/#projects">Projects</a>
        <a href="/#faq">FAQ</a>
        <a href="/#contact">Contact us</a>
      </nav>
      <div class="col">
        <p class="hd">Talk to us</p>
        <a href={site.phoneHref} class="b" data-track="phone_click" data-track-location="footer">{site.phoneDisplay}</a>
        <a href={waDefault} data-track="whatsapp_click" data-track-location="footer">WhatsApp</a>
        <a href={site.groupCompany.url} rel="noopener">Group company: {site.groupCompany.name}</a>
      </div>
    </div>
    <div class="copy">Copyright &copy; {site.name}. {year}</div>
  </div>
</footer>

<style>
  .ftr { background: var(--darker); color: var(--white); }
  .ftr-in { padding-top: 56px; padding-bottom: 32px; }
  .cols { display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; margin-bottom: 40px; }
  .about { flex: 1 1 280px; max-width: 360px; }
  .name { font-weight: 900; font-size: 22px; line-height: 1; text-transform: uppercase; margin-bottom: 14px; }
  .txt { font-size: 15px; line-height: 1.7; color: #D5D9DF; }
  .col { flex: 1 1 200px; display: flex; flex-direction: column; font-size: 15px; }
  .col a { display: flex; align-items: center; min-height: 44px; }
  .col a:hover { text-decoration: underline; }
  .b { font-weight: 800; }
  .hd { font-weight: 800; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--red-on-dark); margin-bottom: 4px; }
  .copy { border-top: 1px solid var(--muted); padding-top: 20px; font-size: 14px; color: #B9BEC6; }
</style>
