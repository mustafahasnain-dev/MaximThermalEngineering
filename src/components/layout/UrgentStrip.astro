---
import { site } from '../../data/site';
---
<div class="strip dark">
  <div class="wrap strip-in">
    <p><strong>Breakdown<span class="hide-sm"> or urgent job</span>?</strong><span class="hide-sm"> Call us directly for the fastest response.</span><span class="sm-only"> Call now</span></p>
    <a href={site.phoneHref} data-track="phone_click" data-track-location="urgent_strip">{site.phoneDisplay}</a>
  </div>
</div>

<style>
  .strip { background: var(--darker); color: var(--white); }
  .strip-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; min-height: 44px; }
  p { font-weight: 700; font-size: 15px; }
  strong { color: var(--red-on-dark); }
  .sm-only { display: none; }
  @media (max-width: 700px) { .sm-only { display: inline; } }
  a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 900; font-size: 17px; }
  @media (max-width: 700px) {
    .strip-in { justify-content: center; gap: 0 10px; flex-wrap: nowrap; }
    a { font-size: 16px; }
    p { font-size: 14px; }
  }
</style>
