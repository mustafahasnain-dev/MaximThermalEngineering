---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/maxim-thermal-engineering-logo.png';
import { site, waDefault } from '../../data/site';
import { offeringsMenu } from '../../data/nav';

const nav = [
  { href: '/#locations', label: 'Locations' },
  { href: '/#about', label: 'About us' },
  { href: '/#contact', label: 'Contact us' },
];
const isHome = Astro.url.pathname === '/';
---
<header class="hdr" data-header>
  <div class="hdr-in">
    <a class="logo" href="/">
      <Image src={logo} alt={`${site.name}, home`} widths={[240, 480]} sizes="240px" loading="eager" class="logo-img" />
    </a>

    <nav class="navs" aria-label="Main">
      <a class="navlink" href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
      <button class="navlink mm-trigger" type="button" aria-expanded="false" aria-controls="mega" data-mega-toggle>
        Offerings
        <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="square" aria-hidden="true"><path d="M5 9l7 7 7-7" /></svg>
      </button>
      {nav.map((n) => <a class="navlink" href={n.href}>{n.label}</a>)}
    </nav>

    <div class="actions">
      <a class="near hide-md" href="/#locations">Nearest workshop</a>
      <a class="quote hide-sm" href="/#quote" data-track="cta_quote" data-track-service="header">Get a Quote &rsaquo;</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>

  <!-- Desktop megamenu -->
  <div id="mega" class="mega" hidden data-mega>
    <div class="mega-in">
      <div class="groups">
        {offeringsMenu.map((g) => (
          <div class="group">
            <a class="g-title" href={g.href}>{g.title}</a>
            <p class="g-blurb">{g.blurb}</p>
            <ul>
              {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
      <aside class="promo dark" aria-label="Get help choosing">
        <p class="p-eyebrow">Not sure what you need?</p>
        <p class="p-title">Send a nameplate photo. Our engineers will tell you.</p>
        <a class="btn btn-red btn-block" href="/#quote" data-track="cta_quote" data-track-service="megamenu">Get a Quote &rsaquo;</a>
        <a class="btn btn-wa btn-block" href={waDefault} data-track="whatsapp_click" data-track-location="megamenu">WhatsApp us</a>
        <a class="p-phone" href={site.phoneHref} data-track="phone_click" data-track-location="megamenu">{site.phoneDisplay}</a>
      </aside>
    </div>
  </div>

  <!-- Mobile and tablet menu -->
  <nav id="mobile-menu" class="mmenu" aria-label="Mobile" hidden>
    <a href="/">Home</a>
    <button class="mm-acc" type="button" aria-expanded="false" aria-controls="mm-offerings" data-mm-acc>
      Offerings
      <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="square" aria-hidden="true"><path d="M5 9l7 7 7-7" /></svg>
    </button>
    <div id="mm-offerings" class="mm-off" hidden>
      {offeringsMenu.map((g) => (
        <div class="mm-group">
          <a class="mm-g-title" href={g.href}>{g.title}</a>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="/#locations">Nearest workshop</a>
    <a class="mm-phone" href={site.phoneHref} data-track="phone_click" data-track-location="mobile_menu">Call {site.phoneDisplay}</a>
  </nav>
</header>
<div class="mega-scrim" hidden data-mega-scrim></div>

<script>
  // Megamenu: click to open, hover with a short delay on mouse devices, Escape / outside click / focus-out to close.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-mega-toggle]');
  const mega = document.querySelector<HTMLElement>('[data-mega]');
  const scrim = document.querySelector<HTMLElement>('[data-mega-scrim]');

  if (header && trigger && mega) {
    let timer: number | undefined;
    const setMega = (open: boolean) => {
      window.clearTimeout(timer);
      trigger.setAttribute('aria-expanded', String(open));
      mega.hidden = !open;
      if (scrim) scrim.hidden = !open;
    };
    const isOpen = () => !mega.hidden;

    trigger.addEventListener('click', () => setMega(!isOpen()));

    const hover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const enter = () => { if (hover.matches) { window.clearTimeout(timer); timer = window.setTimeout(() => setMega(true), 120); } };
    const leave = () => { if (hover.matches) { window.clearTimeout(timer); timer = window.setTimeout(() => setMega(false), 250); } };
    trigger.addEventListener('mouseenter', enter);
    trigger.addEventListener('mouseleave', leave);
    mega.addEventListener('mouseenter', () => window.clearTimeout(timer));
    mega.addEventListener('mouseleave', leave);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { setMega(false); trigger.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !header.contains(e.target as Node)) setMega(false);
    });
    mega.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMega(false); });
    mega.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !mega.contains(next) && next !== trigger) setMega(false);
    });
    window.matchMedia('(max-width: 1000px)').addEventListener('change', (m) => { if (m.matches) setMega(false); });
  }

  // Mobile menu and its Offerings accordion.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const label = document.querySelector('[data-menu-label]');
  const acc = document.querySelector<HTMLButtonElement>('[data-mm-acc]');
  const accPanel = document.getElementById('mm-offerings');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  }
  if (acc && accPanel) {
    acc.addEventListener('click', () => {
      const open = acc.getAttribute('aria-expanded') !== 'true';
      acc.setAttribute('aria-expanded', String(open));
      accPanel.hidden = !open;
    });
  }
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 30; background: var(--white); box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08); }
  .hdr-in { position: relative; display: flex; align-items: stretch; justify-content: space-between; gap: 20px; min-height: var(--header-h); padding-left: max(16px, 4vw); }
  .logo { display: flex; align-items: center; flex: none; }
  .logo-img { width: 240px; height: auto; }

  .navs { display: flex; align-items: stretch; gap: 32px; }
  .navlink { display: flex; align-items: center; gap: 6px; font-family: var(--font); font-weight: 700; font-size: 17px; padding: 0 2px; color: var(--ink); background: none; border: 0; border-bottom: 3px solid transparent; border-top: 3px solid transparent; cursor: pointer; }
  .navlink:hover, .navlink[aria-current='page'], .mm-trigger[aria-expanded='true'] { border-bottom-color: var(--red); }
  .chev { transition: transform 0.15s; }
  [aria-expanded='true'] > .chev { transform: rotate(180deg); }

  .actions { display: flex; align-items: stretch; }
  .near { display: inline-flex; align-items: center; padding: 0 22px; font-weight: 800; font-size: 16px; min-height: 44px; }
  .near:hover { color: var(--red-hover); }
  .quote { display: flex; align-items: center; padding: 0 38px; background: var(--red); color: var(--white); font-weight: 800; font-size: 18px; }
  .quote:hover { background: var(--red-hover); }
  .menu-btn { display: none; align-self: center; margin-right: 16px; width: 48px; height: 48px; background: transparent; border: 2px solid var(--ink); border-radius: 0; color: var(--ink); align-items: center; justify-content: center; cursor: pointer; }

  /* Megamenu */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--white); border-top: 1px solid var(--rule); border-bottom: 6px solid var(--red); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18); max-height: calc(100vh - var(--header-h) - 20px); overflow-y: auto; }
  .mega-in { max-width: 1320px; margin: 0 auto; padding: 36px 40px 40px; display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; }
  .groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 36px; }
  .g-title { display: inline-block; font-weight: 900; font-size: 17px; line-height: 1.25; text-transform: uppercase; padding-bottom: 8px; border-bottom: 3px solid var(--red); }
  .g-title:hover { color: var(--red-hover); }
  .g-blurb { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 10px 0 6px; }
  .group a:not(.g-title) { display: flex; align-items: center; min-height: 36px; font-weight: 700; font-size: 15px; color: var(--ink); }
  .group a:not(.g-title)::before { content: ''; width: 6px; height: 6px; background: var(--red); margin-right: 10px; flex: none; }
  .group a:not(.g-title):hover { color: var(--red-hover); text-decoration: underline; }
  .promo { background: var(--darker); color: var(--white); padding: 28px; display: flex; flex-direction: column; gap: 12px; align-self: start; border-top: 6px solid var(--red); }
  .p-eyebrow { font-weight: 800; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--red-on-dark); }
  .p-title { font-weight: 900; font-size: 22px; line-height: 1.2; margin-bottom: 8px; }
  .p-phone { display: flex; align-items: center; justify-content: center; min-height: 44px; font-weight: 900; font-size: 18px; }
  .mega-scrim { position: fixed; inset: 0; z-index: 20; background: rgba(20, 22, 26, 0.35); }

  /* Mobile menu */
  .mmenu { display: flex; flex-direction: column; border-top: 1px solid var(--rule); padding: 8px 16px 16px; background: var(--white); max-height: calc(100vh - var(--header-h) - var(--bar-h)); overflow-y: auto; }
  .mmenu > a, .mm-acc { display: flex; align-items: center; justify-content: space-between; min-height: 48px; font-family: var(--font); font-weight: 800; font-size: 17px; color: var(--ink); border: 0; border-bottom: 1px solid var(--rule); background: none; padding: 0; text-align: left; cursor: pointer; }
  .mmenu .mm-phone { color: var(--red-hover); border-bottom: 0; }
  .mm-off { padding: 8px 0 8px 12px; border-left: 3px solid var(--red); margin: 8px 0; }
  .mm-group { padding: 8px 0; }
  .mm-g-title { display: flex; align-items: center; min-height: 44px; font-weight: 900; font-size: 15px; text-transform: uppercase; }
  .mm-group a:not(.mm-g-title) { display: flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 15px; color: var(--muted); }

  @media (max-width: 1280px) {
    .navs { gap: 22px; }
    .mega-in { grid-template-columns: minmax(0, 1fr) 260px; gap: 28px; padding: 28px 28px 32px; }
    .groups { gap: 28px; }
  }
  @media (max-width: 1200px) { .hide-md { display: none; } }
  @media (max-width: 1000px) {
    .navs { display: none; }
    .mega, .mega-scrim { display: none !important; }
    .menu-btn { display: flex; }
    .quote { padding: 0 24px; }
  }
  @media (max-width: 700px) {
    .logo-img { width: 190px; }
    .menu-btn { margin-right: 0; }
    .hdr-in { padding: 0 16px; }
  }
</style>
