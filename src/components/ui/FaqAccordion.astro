---
interface Props {
  items: { q: string; a: string }[];
  id: string;
  headingLevel?: 'h2' | 'h3';
}
const { items, id, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="list" data-faq>
  {items.map((f, i) => (
    <div class="item">
      <H class="qh">
        <button class="q" type="button" id={`${id}-q${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${id}-a${i}`}>
          <span>{f.q}</span>
          <span class="sign" aria-hidden="true"></span>
        </button>
      </H>
      <div class="a" id={`${id}-a${i}`} role="region" aria-labelledby={`${id}-q${i}`} hidden={i !== 0}>
        <p>{f.a}</p>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('[data-faq]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('button.q')];
    const panel = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls') || '');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        // One answer open at a time, as in the design.
        btns.forEach((o) => {
          const p = panel(o);
          const isThis = o === b && open;
          o.setAttribute('aria-expanded', String(isThis));
          if (p) p.hidden = !isThis;
        });
      }),
    );
  });
</script>

<style>
  .list { border-bottom: 2px solid var(--ink); }
  .qh { margin: 0; font-size: inherit; }
  .q { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; text-align: left; background: transparent; border: 0; border-top: 2px solid var(--ink); padding: 20px 0; min-height: 64px; cursor: pointer; font-family: var(--font); font-weight: 800; font-size: 18px; line-height: 1.3; color: var(--ink); }
  .q:hover { color: var(--red-hover); }
  .sign { font-weight: 900; font-size: 26px; color: var(--red); flex-shrink: 0; width: 20px; text-align: center; }
  .sign::before { content: '+'; }
  .q[aria-expanded='true'] .sign::before { content: '\2212'; }
  .a p { font-size: 17px; line-height: 1.7; color: var(--muted); padding: 0 40px 24px 0; }
  @media (max-width: 700px) {
    .q { font-size: 17px; }
    .a p { padding-right: 0; }
  }
</style>
