---
import { site, waDefault } from '../../data/site';
import LeadHidden from './LeadHidden.astro';
import WaIcon from './WaIcon.astro';

interface Props {
  heading?: string;
  intro?: string;
  formName?: string;
  service?: string;
  waHref?: string;
}
const {
  heading = 'Tell us what needs cooling.',
  intro = 'Send a requirement, a nameplate photo or a drawing. We will come back with a clear technical answer and a quote.',
  formName = 'contact',
  service,
  waHref = waDefault,
} = Astro.props;
---
<section id="contact" class="ct dark" aria-labelledby="ct-h">
  <div class="wrap in">
    <div class="copy">
      <h2 id="ct-h">{heading}</h2>
      <p>{intro}</p>
      <div class="row">
        <a class="btn btn-wa" href={waHref} data-track="whatsapp_click" data-track-location="contact" data-track-service={service}><WaIcon /> WhatsApp us</a>
        <a class="tel" href={site.phoneHref} data-track="phone_click" data-track-location="contact">{site.phoneDisplay}</a>
      </div>
    </div>
    <div class="box">
      <form action={site.formAction} method="post" novalidate data-lead-form={formName} data-track="generate_lead" data-track-form={formName} aria-labelledby="cf-h">
        <LeadHidden form={formName} />
        {service && <input type="hidden" name="service" value={service} />}
        <h3 id="cf-h">Get a quote</h3>
        <p class="intro">Three fields and we will take it from there.</p>
        <div class="fields">
          <div>
            <label class="lbl" for="c-name">Your name</label>
            <input class="fld" id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="c-name-err" />
            <span class="err" id="c-name-err"></span>
          </div>
          <div>
            <label class="lbl" for="c-ph">Phone / WhatsApp</label>
            <input class="fld" id="c-ph" name="phone" type="tel" inputmode="tel" autocomplete="tel" required data-phone aria-describedby="c-ph-err" />
            <span class="err" id="c-ph-err"></span>
          </div>
          <div>
            <label class="lbl" for="c-msg">What do you need?</label>
            <textarea class="fld" id="c-msg" name="details" rows="3" required aria-describedby="c-msg-err"></textarea>
            <span class="err" id="c-msg-err"></span>
          </div>
          <button class="btn btn-red btn-block" type="submit">Send my request &rsaquo;</button>
        </div>
      </form>
      <div class="done" role="status" tabindex="-1" data-lead-success hidden>
        <h3>Request received</h3>
        <p>Thank you. Our team will contact you on the number you gave.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ct { background: var(--dark); color: var(--white); border-top: 6px solid var(--red); }
  .in { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 48px; padding-top: 80px; padding-bottom: 80px; }
  .copy { flex: 1 1 460px; min-width: 0; }
  h2 { font-weight: 900; font-size: clamp(32px, 4vw, 54px); line-height: 1.08; margin-bottom: 18px; }
  .copy p { font-size: 19px; line-height: 1.6; max-width: 520px; margin-bottom: 28px; color: #E4E8ED; }
  .row { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .tel { display: inline-flex; align-items: center; min-height: 44px; font-weight: 900; font-size: 22px; }
  .box { flex: 1 1 380px; max-width: 480px; min-width: 0; background: var(--white); color: var(--ink); padding: 32px; border-top: 8px solid var(--red); }
  .box a:focus-visible, .box button:focus-visible, .box input:focus-visible, .box textarea:focus-visible { outline-color: var(--blue); }
  h3 { font-weight: 900; font-size: 28px; line-height: 1.1; margin-bottom: 8px; }
  .intro { font-size: 16px; line-height: 1.55; color: var(--muted); margin-bottom: 22px; }
  .fields { display: flex; flex-direction: column; gap: 14px; }
  .done { padding: 24px 0; }
  .done h3 { margin-bottom: 12px; }
  .done p { font-size: 16px; line-height: 1.7; color: var(--muted); }
  @media (max-width: 700px) {
    .in { padding-top: 64px; padding-bottom: 64px; gap: 36px; }
    .box { padding: 28px 16px; max-width: none; margin: 0 -16px; flex-basis: calc(100% + 32px); }
  }
</style>
