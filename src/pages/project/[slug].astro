---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TitleSection from '../../components/TitleSection.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { projects } from '../../data/projects';
import { page, decode } from '../../lib/pages';
import { upload } from '../../lib/img';
import { fixHtml } from '../../lib/blocks';
import PortfolioDetail from '../../components/PortfolioDetail.astro';
import { portfolio, type PortfolioItem } from '../../data/portfolio';

export function getStaticPaths() {
  return [
    ...projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: projects[(i - 1 + projects.length) % projects.length], item: undefined } })),
    ...portfolio.map((item) => ({ params: { slug: item.slug }, props: { item, p: projects[0], prev: projects[0] } })),
  ];
}
const { p, prev, item } = Astro.props as { p: (typeof projects)[number]; prev: (typeof projects)[number]; item?: PortfolioItem };
const data = page(`project_${p.slug}`);
const img = upload(data.project?.img || p.img);
// The old project text used several H1s as section headings; keep one H1 on the page.
const html = fixHtml(data.project?.html || '').replace(/<h1(\s|>)/g, '<h2$1').replace(/<\/h1>/g, '</h2>');
---
{item ? <PortfolioDetail p={item} /> : (
<Layout title={decode(data.title)} description={data.description}>
  <TitleSection title="Projects" tag="p" crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/project/' }, { label: 'Project', href: '/project-category/project/' }, { label: p.title }]} />
  <article class="pj">
    <div class="container">
      {img && <Image class="pj-img" src={img} alt={data.project?.alt || p.title} widths={[800, 1200]} sizes="(max-width: 1248px) 100vw, 1200px" loading="eager" />}
      <div class="pj-desc">
        <h1 class="pj-title">{p.title}</h1>
        <h5 class="pj-label">Project description</h5>
        <div class="prose" set:html={html} />
      </div>
    </div>
  </article>
  <section class="related container">
    <h4 class="rel-title">Related projects</h4>
    <ProjectGrid exclude={p.slug} />
    <nav class="pnav" aria-label="Projects">
      <a href={`/project/${prev.slug}/`} rel="prev" aria-label="Previous project">
        <svg width="8" height="13" viewBox="0 0 8 13" aria-hidden="true"><path d="M6.5 1.5l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      </a>
      <a href="/project/" aria-label="All projects">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M0 0h4v4H0zM6 0h4v4H6zM12 0h4v4h-4zM0 6h4v4H0zM6 6h4v4H6zM12 6h4v4h-4zM0 12h4v4H0zM6 12h4v4H6zM12 12h4v4h-4z" /></svg>
      </a>
    </nav>
  </section>
</Layout>
)}
<style>
  .pj { padding: 64px 0 48px; }
  .pj :global(.pj-img) { width: 100%; height: auto; margin-bottom: 48px; }
  .pj-desc { max-width: 900px; }
  .pj-title { font-size: 40px; line-height: 48px; margin-bottom: 16px; }
  .pj-label { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--red); margin-bottom: 24px; }
  .prose :global(h2) { font-size: 32px; line-height: 40px; margin: 32px 0 16px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
  .prose :global(ul) { margin-bottom: 16px; }
  .related { padding: 32px 0 96px; }
  .rel-title { font-size: 24px; margin-bottom: 32px; }
  .pnav { display: flex; justify-content: center; gap: 8px; margin-top: 48px; }
  .pnav a { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line); color: var(--ink); }
  .pnav a:hover { background: var(--red); border-color: var(--red); color: #fff; }
  @media (max-width: 767px) { .pj-title { font-size: 30px; line-height: 38px; } .prose :global(h2) { font-size: 24px; line-height: 32px; } }
</style>
