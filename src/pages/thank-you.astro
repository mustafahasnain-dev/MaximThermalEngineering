---
import Layout from '../layouts/Layout.astro';
import TitleSection from '../components/TitleSection.astro';
import { site } from '../data/site';
---
<Layout title="Thank you - Maxim Thermal Engineering" description="Thank you for contacting Maxim Thermal Engineering. Our team will get back to you shortly." noindex>
  <TitleSection title="Thank you" crumbs={[{ label: 'Home', href: '/' }, { label: 'Thank you' }]} />
  <section class="container sec">
    <p>Thank you for your message. It has been sent.</p>
    <p>For urgent requirements call <a href={site.phoneHref}>{site.phone}</a> or message us on <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>.</p>
    <a class="btn" href="/">Back to home</a>
  </section>
</Layout>
<style>.sec { padding: 80px 0 96px; } .sec a:not(.btn) { color: var(--red); font-weight: 700; } .btn { margin-top: 16px; }</style>
