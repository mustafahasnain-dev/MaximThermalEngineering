---
import Layout from '../layouts/Layout.astro';
import Blocks from '../components/wp/Blocks.astro';
import { page, decode } from '../lib/pages';

const home = page('home');
// Give the services heading an id so "Our services" can link to it.
const tag = (items: any[]): void => items.forEach((b) => {
  if (b.t === 'row') b.cols.forEach((c: any) => tag(c.items));
  else if (b.t === 'h' && /Radiator Solutions/i.test(b.html)) b.id = 'services';
});
tag(home.rows);
---
<Layout title={decode(home.title)} description={home.description} ogImage="/video/hero-poster.jpg">
  <section class="hero" aria-label="Powering Performance Through Efficient Cooling">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true">
      <source src="/video/hero-section-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-in">
      <p class="hero-title"><span>Powering Performance</span> <span>Through Efficient Cooling</span></p>
      <p class="hero-sub">Trusted industrial radiator solutions built for the toughest environments.</p>
      <a class="btn btn-outline-light hero-btn" href="#services">Our services <svg class="chev" viewBox="0 0 7 11" aria-hidden="true"><path d="M1 1l4.5 4.5L1 10" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>
    </div>
  </section>
  <Blocks items={home.rows} />
</Layout>

<style>
  .hero { position: relative; height: 100vh; min-height: 560px; max-height: 900px; overflow: hidden; background: #1b1d21; color: #fff; display: flex; align-items: center; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: rgba(0, 0, 0, .28); }
  .hero-in { position: relative; width: 100%; padding: 0 72px; }
  .hero-title { margin: 0 0 16px; font-size: 72px; line-height: 76px; font-weight: 800; letter-spacing: -.5px; color: #fff; }
  .hero-title span { display: block; }
  .hero-sub { font-size: 20px; line-height: 30px; margin: 0 0 32px; color: #fff; }
  .hero-btn { height: 56px; padding: 0 28px; font-weight: 600; }
  @media (max-width: 1023px) {
    .hero-in { padding: 0 24px; }
    .hero-title { font-size: 48px; line-height: 54px; }
  }
  @media (max-width: 599px) {
    .hero { height: 560px; }
    .hero-title { font-size: 36px; line-height: 42px; }
    .hero-sub { font-size: 17px; line-height: 26px; }
    }
</style>

