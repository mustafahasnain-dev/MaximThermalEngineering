---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TitleSection from '../../components/TitleSection.astro';
import PostCard from '../../components/PostCard.astro';
import { posts, type Post } from '../../data/posts';
import { upload } from '../../lib/img';
import { fixHtml } from '../../lib/blocks';
import { decode } from '../../lib/pages';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props as { post: Post };
const img = upload(post.img);
const related = posts.filter((p) => p.slug !== post.slug).slice(0, 2);
const url = encodeURIComponent(new URL(Astro.url.pathname, 'https://www.maximthermalengg.com').href);
const html = fixHtml(post.html).replace(/^<div class="post-content et-clearfix">|<\/div>$/g, '');
---
<Layout title={decode(post.seoTitle)} description={post.description}>
  <TitleSection title="Blog" tag="p" crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: 'Heat Exchanger', href: '/category/heat-exchanger/' }, { label: post.title }]} />
  <div class="container layout">
    <article class="post">
      {img && <Image class="post-img" src={img} alt={post.title} width={1200} height={720} fit="cover" widths={[800, 1200]} sizes="(max-width: 1023px) 100vw, 800px" loading="eager" />}
      <div class="post-meta">Posted on <span>{post.date}</span> in <a href="/category/heat-exchanger/">Heat Exchanger</a></div>
      <h1 class="post-title">{post.title}</h1>
      <div class="share">
        <a href={`https://www.facebook.com/sharer.php?u=${url}`} target="_blank" rel="noopener" aria-label="Share on Facebook"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8V6.3c0-.8.2-1.3 1.4-1.3H17V2h-2.6C11.3 2 10 3.6 10 6.3V8H8v3h2v10h4V11h2.7l.4-3z" /></svg></a>
        <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${url}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z" /></svg></a>
        <a href={`https://api.whatsapp.com/send?text=${url}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg width="14" height="14" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.4.7 4.7 1.9 6.7L3 29l6.9-2.1c1.9 1 4 1.6 6.1 1.6 7 0 12.7-5.7 12.7-12.7S23 3 16 3z" /></svg></a>
      </div>
      <div class="prose" set:html={html} />
      <section class="related" aria-labelledby="rel">
        <h4 id="rel">Related posts</h4>
        <div class="rel-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    </article>
    <aside class="sidebar">
      <div class="widget">
        <h5>Categories</h5>
        <ul class="cats"><li><a href="/category/heat-exchanger/">Heat Exchanger</a></li></ul>
      </div>
      <div class="widget">
        <h5>Recent posts</h5>
        <ul class="recent">
          {posts.slice(0, 5).map((p) => {
            const m = upload(p.img);
            return (
              <li>
                <a href={`/heat-exchanger/${p.slug}/`} class="thumb" tabindex="-1" aria-hidden="true">{m && <Image src={m} alt={p.title} width={72} height={72} fit="cover" loading="lazy" />}</a>
                <div><h6><a href={`/heat-exchanger/${p.slug}/`}>{p.title}</a></h6><span>{p.date}</span></div>
              </li>
            );
          })}
        </ul>
      </div>
    </aside>
  </div>
</Layout>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 64px; padding: 80px 0 96px; }
  .post :global(.post-img) { width: 100%; height: auto; margin-bottom: 32px; }
  .post-meta { font-size: 14px; font-weight: 600; color: #9e9e9e; margin-bottom: 8px; }
  .post-meta a, .post-meta span { color: var(--red); }
  .post-title { font-size: 40px; line-height: 48px; margin-bottom: 24px; }
  .share { display: flex; gap: 8px; margin-bottom: 32px; }
  .share a { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line); color: var(--ink); }
  .share a:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .prose :global(h2) { font-size: 28px; line-height: 36px; margin: 32px 0 16px; }
  .prose :global(h3) { font-size: 22px; line-height: 30px; margin: 28px 0 12px; }
  .prose :global(li) { margin-bottom: 4px; }
  .related { margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--line); }
  .related h4 { font-size: 24px; margin-bottom: 24px; }
  .rel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .widget { margin-bottom: 48px; }
  .widget h5 { font-size: 18px; line-height: 26px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .cats { list-style: none; padding: 0; margin: 0; }
  .cats a { font-weight: 600; color: var(--ink); }
  .cats a:hover, .recent a:hover { color: var(--red); }
  .recent { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; }
  .recent li { display: flex; gap: 16px; align-items: flex-start; }
  .recent .thumb { flex: none; }
  .recent :global(img) { width: 72px; height: 72px; object-fit: cover; }
  .recent h6 { font-size: 15px; line-height: 22px; margin: 0 0 4px; }
  .recent span { font-size: 13px; line-height: 20px; color: #9e9e9e; }
  @media (max-width: 1023px) { .layout { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 599px) { .post-title { font-size: 30px; line-height: 38px; } .rel-grid { grid-template-columns: 1fr; } }
</style>
