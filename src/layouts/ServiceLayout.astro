---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import ContactSection from '../components/ui/ContactSection.astro';
import WaIcon from '../components/ui/WaIcon.astro';
import { site, wa, locations } from '../data/site';
import { type Service, serviceUrl, breadcrumbs, relatedServices, childrenOf, parentId, label } from '../lib/services';

interface Props {
  entry: Service;
  all: Service[];
}
const { entry, all } = Astro.props;
const d = entry.data;
const crumbs = breadcrumbs(entry, all);
const related = relatedServices(entry, all);
const children = childrenOf(entry.id, all);
const pid = parentId(entry.id);
const parent = pid ? all.find((s) => s.id === pid) : undefined;
const url = new URL(serviceUrl(entry.id), Astro.site).href;
const waHref = wa(d.waText);
const slugKey = entry.id.replace(/\//g, '_');

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#service`,
    name: d.title,
    description: d.description,
    serviceType: d.title,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'Pakistan' },
    ...(d.brand ? { brand: { '@type': 'Brand', name: d.brand } } : {}),
    ...(parent ? { isRelatedTo: { '@type': 'Service', name: parent.data.title, url: new URL(serviceUrl(parent.id), Astro.site).href } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const sites = locations.filter((l) => d.cities.includes(l.city.toLowerCase() as never));
---
<BaseLayout title={d.seoTitle} description={d.description} breadcrumbs={crumbs} schema={schema}>
  <section class="top dark">
    <div class="wrap top-in">
      <Breadcrumbs items={crumbs} />
      <div class="top-grid">
        <div>
          <h1>{d.title}</h1>
          <p class="def">{d.definition}</p>
          <div class="btn-row">
            <a class="btn btn-red" href="#contact" data-need={d.quoteNeed} data-prefill={`Service: ${d.title}`} data-track="cta_quote" data-track-service={slugKey}>Get a quote &rsaquo;</a>
            <a class="btn btn-wa" href={waHref} data-track="whatsapp_click" data-track-location="service_top" data-track-service={slugKey}><WaIcon /> Ask on WhatsApp</a>
          </div>
        </div>
        <div class="top-img">
          <Image src={d.image} alt={d.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 1000px) 100vw, 520px" loading="eager" class="img-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="what-h">
    <div class="wrap">
      <h2 class="banner" id="what-h">What we make and do</h2>
      <div class="g3 offers">
        {d.offerings.map((o) => (
          <div class="offer">
            <h3>{o.title}</h3>
            <p>{o.text}</p>
          </div>
        ))}
      </div>
      {children.length > 0 && (
        <div class="children">
          <h3 class="sub-h">Choose your equipment</h3>
          <ul class="g3 child-list">
            {children.map((c) => (
              <li><a href={serviceUrl(c.id)}><strong>{label(c)}</strong><span>{c.data.summary}</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="sec grey" aria-labelledby="spec-h">
    <div class="wrap two">
      <div>
        <h2 class="banner" id="spec-h">Specifications</h2>
        <div class="tbl-wrap">
          <table>
            <caption>{d.specs.caption}</caption>
            <tbody>
              {d.specs.rows.map((r) => (
                <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <h2 class="banner" id="who-h">Who it is for</h2>
        <ul class="bul bul-1 who">{d.audience.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>
  </section>

  <div class="sec prose-sec">
    <div class="wrap prose"><slot /></div>
  </div>

  <section class="sec" aria-labelledby="proc-h">
    <div class="wrap">
      <h2 class="banner" id="proc-h">Our process</h2>
      <ol class="g4 proc">
        {d.process.map((p, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {d.projectExample && (
    <section class="sec grey" aria-labelledby="proj-h">
      <div class="wrap">
        <h2 class="banner" id="proj-h">Project example</h2>
        <article class="proj">
          <h3>{d.projectExample.title}</h3>
          <p>{d.projectExample.scope}</p>
          <p><strong>Result:</strong> {d.projectExample.result}</p>
          <a class="clink" href="#contact" data-prefill={`Similar to: ${d.projectExample.title}`} data-need={d.quoteNeed} data-track="cta_quote" data-track-service={`${slugKey}_project`}>Quote a similar job &rsaquo;</a>
        </article>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="faq-h">
    <div class="wrap two faq-grid">
      <div>
        <h2 class="banner" id="faq-h">Questions</h2>
        <p class="faq-side">Do not see your question? Send it on WhatsApp and an engineer will reply.</p>
        <a class="btn btn-wa" href={waHref} data-track="whatsapp_click" data-track-location="service_faq" data-track-service={slugKey}><WaIcon /> Ask on WhatsApp</a>
      </div>
      <FaqAccordion items={d.faqs} id={`faq-${slugKey}`} />
    </div>
  </section>

  <section class="sec grey" aria-labelledby="rel-h">
    <div class="wrap">
      <h2 class="banner" id="rel-h">Related services</h2>
      <ul class="g3 rel">
        {parent && (
          <li><a href={serviceUrl(parent.id)}><span class="eyebrow">Back to</span><strong>{parent.data.title}</strong><span>{parent.data.summary}</span></a></li>
        )}
        {related.filter((r) => r.id !== parent?.id).map((r) => (
          <li><a href={serviceUrl(r.id)}><span class="eyebrow">Related</span><strong>{r.data.title}</strong><span>{r.data.summary}</span></a></li>
        ))}
      </ul>
      <p class="served">Served from
        {sites.map((l, i) => (<>{i > 0 && (i === sites.length - 1 ? ' and ' : ', ')}<a href="/#locations">{l.kind.toLowerCase()} in {l.city}</a></>))}, with installation anywhere in Pakistan.
      </p>
    </div>
  </section>

  <section class="cta dark" aria-labelledby="cta-h">
    <div class="wrap cta-in">
      <h2 id="cta-h">Need a quote for {d.navLabel ?? d.title.toLowerCase()}?</h2>
      <div class="btn-row">
        <a class="btn btn-ink" href="#contact" data-need={d.quoteNeed} data-prefill={`Service: ${d.title}`} data-track="cta_quote" data-track-service={`${slugKey}_band`}>Request a quote &rsaquo;</a>
        <a class="tel" href={site.phoneHref} data-track="phone_click" data-track-location="service_cta">Call {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <ContactSection
    heading={`Get a quote for ${d.navLabel ?? d.title.toLowerCase()}.`}
    intro="Send the make, model or rating, a nameplate photo and your city. An engineer will reply with a clear technical answer and a quote."
    formName="service"
    service={entry.id}
    waHref={waHref}
  />
</BaseLayout>

<style>
  .top { background: var(--darker); color: var(--white); }
  .top-in { padding-top: 16px; padding-bottom: 56px; }
  .top-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; align-items: center; margin-top: 16px; }
  h1 { font-weight: 900; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.06; margin-bottom: 18px; }
  .def { font-size: 19px; line-height: 1.65; color: #E4E8ED; margin-bottom: 28px; max-width: 640px; }
  .top-img { height: 340px; background: #2B3A47; border-bottom: 6px solid var(--red); }

  .sec { padding-top: 72px; padding-bottom: 72px; }
  .grey { background: var(--grey); }
  .two { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 48px; }
  .offers { margin-top: 36px; }
  .offer { border-top: 4px solid var(--red); padding-top: 16px; }
  .offer h3 { font-weight: 900; font-size: 20px; line-height: 1.25; margin-bottom: 8px; }
  .offer p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  .children { margin-top: 48px; }
  .sub-h { font-weight: 900; font-size: 22px; text-transform: uppercase; margin-bottom: 20px; padding-top: 16px; border-top: 2px solid var(--ink); }
  .child-list a, .rel a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 20px; background: var(--grey); border-left: 5px solid var(--red); }
  .rel a { background: var(--white); }
  .child-list a:hover strong, .rel a:hover strong { color: var(--red-hover); text-decoration: underline; }
  .child-list strong, .rel strong { font-weight: 900; font-size: 18px; line-height: 1.25; }
  .child-list span, .rel span:not(.eyebrow) { font-size: 15px; line-height: 1.55; color: var(--muted); }
  .rel { margin-top: 32px; }

  .tbl-wrap { margin-top: 28px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--white); font-size: 16px; }
  caption { text-align: left; font-weight: 800; font-size: 14px; color: var(--muted); padding-bottom: 10px; }
  th, td { text-align: left; vertical-align: top; padding: 14px 16px; border-bottom: 1px solid var(--rule); line-height: 1.5; }
  th { width: 38%; font-weight: 800; background: #EBEDF0; }
  .who { margin-top: 28px; }

  .prose-sec { padding-top: 64px; padding-bottom: 8px; }
  .prose { max-width: 860px; }
  .prose :global(h2) { font-weight: 900; font-size: clamp(24px, 2.6vw, 32px); line-height: 1.2; margin: 0 0 14px; }
  .prose :global(h3) { font-weight: 900; font-size: 21px; line-height: 1.25; margin: 28px 0 10px; }
  .prose :global(p), .prose :global(li) { font-size: 17px; line-height: 1.75; color: var(--muted); }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 22px; padding-left: 22px; list-style: revert; }
  .prose :global(* + h2) { margin-top: 44px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) { color: var(--red-hover); font-weight: 800; text-decoration: underline; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 18px; background: var(--white); font-size: 16px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 12px 14px; border-bottom: 1px solid var(--rule); line-height: 1.5; color: var(--ink); }
  .prose :global(thead th) { background: var(--ink); color: var(--white); font-weight: 800; font-size: 14px; }
  .prose :global(tbody td:first-child) { font-weight: 700; }

  .proc { margin: 36px 0 0; padding: 0; list-style: none; }
  .proc li { display: flex; flex-direction: column; gap: 10px; }
  .n { width: 46px; height: 46px; background: var(--red); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 18px; }
  .proc h3 { font-weight: 900; font-size: 19px; line-height: 1.25; }
  .proc p { font-size: 16px; line-height: 1.65; color: var(--muted); }

  .proj { margin-top: 32px; background: var(--white); border-top: 6px solid var(--red); padding: 28px; display: flex; flex-direction: column; gap: 10px; max-width: 860px; }
  .proj h3 { font-weight: 900; font-size: 23px; line-height: 1.2; }
  .proj p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  .proj strong { color: var(--ink); }

  .faq-grid { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); }
  .faq-side { font-size: 17px; line-height: 1.65; color: var(--muted); margin: 20px 0 24px; }
  .served { margin-top: 32px; font-size: 16px; line-height: 1.7; color: var(--muted); }
  .served a { color: var(--red-hover); font-weight: 800; text-decoration: underline; }

  .cta { background: var(--red); color: var(--white); }
  .cta-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; padding-top: 44px; padding-bottom: 44px; }
  .cta h2 { font-weight: 900; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.15; max-width: 640px; }
  .cta .btn-ink { border-color: var(--white); }
  .tel { display: inline-flex; align-items: center; min-height: 52px; font-weight: 900; font-size: 19px; }

  @media (max-width: 1000px) {
    .top-grid, .two, .faq-grid { grid-template-columns: minmax(0, 1fr); }
    .top-img { height: 260px; }
  }
  @media (max-width: 700px) {
    .sec { padding-top: 56px; padding-bottom: 56px; }
    .top-in { padding-bottom: 40px; }
    .def { font-size: 18px; }
    .btn-row .btn { flex: 1 1 100%; }
    th, td { padding: 12px; font-size: 15px; }
    th { width: 42%; }
    .proj { padding: 24px 16px; }
  }
</style>
